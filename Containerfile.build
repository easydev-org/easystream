# Build the easystream daemon (Linux / X11 / Wayland) with the SHARED web UI
# embedded.
#
# The UI is not vendored in this repo: it is fetched from the single source of
# truth (easydev-org/easystream-webui) here, at build time, and lands in
# webui/ where `include_str!` inlines it into the binary.
#
# Plain, self-contained build: no proxy settings, no private registries, no
# mirror addresses. It behaves identically on a laptop, on CI, and in a cluster.
# If an environment needs an egress proxy, that belongs to the builder
# (buildkitd / the daemon), NOT to this file.
#
#   docker build -f Containerfile.build .
ARG REGISTRY=docker.io/library
FROM ${REGISTRY}/rust:1-bookworm

ARG WEBUI_REF=main
ENV CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The Linux backend links D-Bus (AT-SPI), libx264, libxcb(-xtest/shm/xfixes/
# render), wayland-client, xkbcommon and libyuv; build.rs compiles the C shims.
#
# Aliyun's Debian mirror over HTTPS. Nothing in this file refers to a private
# registry, so it builds the same way on a laptop, in CI, and in the cluster.
#
# HTTPS matters: an egress proxy that fronts the build refuses plain http:// and
# returns its own "404 Cannot find any route matching", which apt reports only as
# "does not have a Release file".
RUN rm -f /etc/apt/sources.list.d/* /etc/apt/sources.list \
    && printf 'deb https://mirrors.aliyun.com/debian bookworm main\n' > /etc/apt/sources.list \
    && printf 'deb https://mirrors.aliyun.com/debian bookworm-updates main\n' >> /etc/apt/sources.list \
    && printf 'deb https://mirrors.aliyun.com/debian-security bookworm-security main\n' >> /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config \
      libdbus-1-dev \
      libx264-dev libyuv-dev libopus-dev \
      libpipewire-0.3-dev \
      libxcb1-dev libxcb-xtest0-dev libxcb-shm0-dev libxcb-xfixes0-dev libxcb-render0-dev \
      libwayland-dev libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src/

RUN bash /src/build-webui.sh && ls -la /src/webui

RUN cargo build --release --manifest-path /src/Cargo.toml
# The single artefact the sandbox image ships.
RUN cp /src/target/release/easystream /easystream
